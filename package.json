{
  "name": "@cartridge/core",
  "version": "0.1.0",
  "description": "State, system calls, and skills for agent-native applications.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./lib/config.d.ts",
      "import": "./lib/config.js"
    },
    "./compiler": {
      "types": "./lib/compiler.d.ts",
      "import": "./lib/compiler.js"
    }
  },
  "files": [
    "lib",
    "supabase/config.toml",
    "supabase/migrations/*.sql",
    "supabase/functions/deno.json",
    "supabase/functions/deno.lock",
    "supabase/functions/mcp/index.ts",
    "supabase/functions/billing-webhook/index.ts",
    "supabase/functions/stripe-webhook/index.ts",
    "supabase/functions/_shared/*.ts",
    "public/oauth/consent/index.html",
    "public/oauth/consent/assets/",
    "web/consent/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsx scripts/build-cartridge.ts && npm run build:ui",
    "build:ui": "vite build --config web/consent/vite.config.ts",
    "build:cartridge": "tsx scripts/build-cartridge.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p web/consent/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@polar-sh/sdk": "0.42.5",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "2.95.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
